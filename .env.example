# Settings for running the container directly with Docker or Compose.
# The Home Assistant app reads these values from its Configuration page instead.
# Direct Docker: mount the token at /run/secrets/ha_token (the default token path).
# Compose: WPE_TOKEN_FILE is the host path mounted at /run/secrets/ha_token.
# Publish the default internal listener with -p HOST_PORT:8080, for example -p 19433:8080.

# Replace the hostname with an HTTP(S) Home Assistant origin reachable from Docker.
# The URL must not include a path component.
HA_URL=http://homeassistant:8123
# Compose host-side token file and published port.
WPE_TOKEN_FILE=./secrets/ha_token
WPE_HOST_PORT=19433
# Optional private CA bundle file, mounted at this path inside the container.
# In Home Assistant, configure the CA path from the app's /ssl directory instead.
# HA_CA_CERT_FILE=/ssl/home-assistant-ca.crt
# Lovelace route used for renderer readiness checks; this is not a route allowlist.
DASHBOARD_PATH=lovelace/energy
# Optional visible text required on DASHBOARD_PATH. Empty disables the text check.
EXPECTED_TEXT=
# Valid range: 1-300 seconds.
RENDER_DEADLINE_SECONDS=55
# Valid range: 0-3600 seconds. After this idle period, the WebKit process is
# stopped; the next screenshot starts a fresh renderer. 0 stops it immediately.
DASHBOARD_REUSE_IDLE_SECONDS=300
# Valid range: 512-3072 MiB.
WEBKIT_PROCESS_MEMORY_LIMIT_MB=512
